{
    "name": "jegex/koboi",
    "description": "Laravel Nova backend rebuilt under the Jegex\\Koboi namespace",
    "keywords": [
        "laravel",
        "admin",
        "nova",
        "koboi"
    ],
    "homepage": "https://github.com/jegex/koboi",
    "version": "5.9.5",
    "license": "MIT",
    "authors": [
        {
            "name": "jegex",
            "email": "hujan008@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "brick/money": "^0.8|^0.9|^0.10|^0.11|^0.12|^0.13",
        "illuminate/filesystem": "^10.48.29|^11.44.1|^12.1.1|^13.0.0",
        "illuminate/support": "^10.48.29|^11.44.1|^12.1.1|^13.0.0",
        "inertiajs/inertia-laravel": "^1.3.2|^2.0|^3.0.0",
        "laravel/fortify": "^1.36.2",
        "laravel/sentinel": "^1.1.0",
        "laravel/serializable-closure": "^1.3|^2.0.0",
        "nesbot/carbon": "^2.62.1|^3.4",
        "openspout/openspout": "^4.24",
        "orchestra/sidekick": "^1.2.18",
        "spatie/once": "^3.0",
        "symfony/console": "^6.4.14|^7.0.3|^8.0.0",
        "symfony/deprecation-contracts": "^2.5|^3.0",
        "symfony/finder": "^6.4.13|^7.0.3|^8.0.0",
        "symfony/http-foundation": "^6.4.13|^7.0.3|^8.0.0",
        "symfony/polyfill-intl-icu": "^1.33",
        "symfony/polyfill-php82": "^1.33",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/process": "^6.4.14|^7.0.3|^8.0.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Jegex\\Koboi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jegex\\Koboi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jegex\\Koboi\\NovaCoreServiceProvider"
            ],
            "aliases": {
                "Nova": "Jegex\\Koboi\\Nova"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "suggest": {
        "ext-intl": "Required to format Currency field"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
